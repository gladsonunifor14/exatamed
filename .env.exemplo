# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Gere valores aleatórios com: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
EXATAMED_SECRET_KEY=
# Chave da cadeia de auditoria: guarde-a em local seguro e NUNCA a altere depois de definida.
EXATAMED_CHAVE_AUDITORIA=
# Primeiro administrador (criado só se ainda não houver usuários).
EXATAMED_ADMIN_LOGIN=admin
EXATAMED_ADMIN_SENHA=
# Atrás de proxy HTTPS mantenha production; para testar em HTTP local use EXATAMED_ENV=development.
EXATAMED_ENV=production
